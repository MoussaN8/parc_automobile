<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chauffeur_report_wizard_form"
        model="ir.ui.view">

        <field name="name">chauffeur.report.wizard.form</field>
        <field name="model">chauffeur.report.wizard</field>

        <field name="arch" type="xml">

            <form string="Rapport des chauffeurs">

                <group>
                    <field name="year" />
                    <field name="month" />
                </group>

                <footer>

                    <button
                        name="action_generate_xlsx"
                        string="Générer Excel"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>
    </record>


    <record id="action_chauffeur_report_wizard"
        model="ir.actions.act_window">

        <field name="name">Rapport chauffeurs</field>

        <field name="res_model">chauffeur.report.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>

    </record>


    <menuitem
        id="menu_chauffeur_report"
        name="Rapport Chauffeurs"
        parent="contacts.menu_contacts"
        action="action_chauffeur_report_wizard"
        sequence="50"
    />

</odoo>