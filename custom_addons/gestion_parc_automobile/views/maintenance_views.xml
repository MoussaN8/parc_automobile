<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- listes des maintenances -->
    <record id="view_voitures_maintenances" model="ir.ui.view">
        <field name="name">voitures.maintenances.tree</field>
        <field name="model">parc.maintenance</field>
        <field name="arch" type="xml">
            <list string="Liste des maintenances">
                <field name="name"/>
                <field name="voiture_id"/>
                <field name="type_service"/>
                <field name="date_service"/>
                <field name="cout_maintenance"/>
                <field name="garage_id"/>
                <field name="etat"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- consulter une maintenance spécifique -->
    <record id="view_parc_maintenance_form" model="ir.ui.view">
        <field name="name">voiture.maintenance.form</field>
        <field name="model">parc.maintenance</field>
        <field name="arch" type="xml">
            <form string="maintenance">
                <!-- Mise en place du status bar-->
                 <header>
                   
                     <!-- Le bouton Planifier est visible que si on est en brouillon -->
                     <button name="action_planifier" string="Planifier" type="object" class="oe_highlight" invisible="etat != 'brouillon'" />

                     <!-- Le bouton action_marquer_terminer est visible que  si on est en planifie -->
                     <button name="action_marquer_terminer" string="Marquer comme terminé" type="object" class="oe_highlight" invisible="etat != 'planifie'" />

                     <!-- Le bouton action_annuler est visible que  si on est en brouillon ou en planifie -->
                     <button name="action_annuler" string="Annuler" type="object" class="oe_highlight" invisible=" etat in ('termine','annule')" />

                     <!--Remettre en brouillon si par erreur on a annulé la maintenance-->
                    <button name="action_brouillon" string="Remettre en brouillon" type="object" class="oe_highlight" invisible="etat != 'annule'" />


                      <!-- Le status bar lié au champ 'etat' avec les bonnes clés techniques -->
                      <field name="etat" widget="statusbar" statusbar_visible="brouillon,planifie,termine,annule"></field>
                 </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="voiture_id"/>
                        <field name="type_service"/>
                        <field name="date_service"/>
                        <field name="cout_maintenance"/>
                        <field name="garage_id"/>
                        <field name="etat"/>
                       
                    </group>

                    <notebook>
                        <page name="Description" string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
        
    </record>

    <!-- rechercher une maintenance -->
    <record id="view_parc_automobile_maintenance" model="ir.ui.view">
        <field name="name">parc.maintenance.search</field>
        <field name="model">parc.maintenance</field>
        <field name="arch" type="xml">
            <!-- champs sur lesquels le user pourrai faire des recherches  -->
            <search>
                <field name="name" />
                <field name="voiture_id" />
                <field name="type_service" />
                
                <!--Filtrage-->
                <filter name="groupby_planifie" string="Planifiées" domain="[('etat', '=', 'planifie')]"/>
                
                <filter name="cette_annee" string="Interventions cette année" domain="[('date_service', '&gt;=',context_today().strftime('%y-%m-01'))]" />

                <separator/>

                <!--Regrouper les maintenances par Type de service ou par Garage.-->
                <group>
                    <filter name="group_type_service" string="Par type service" context="{'group_by': 'type_service'}" />

                    <filter name="group_garage" string="Par garage" context="{'group_by': 'garage_id'}" />
                    <filter name="group_etat" string="Par état" context="{'group_by': 'etat'}" />
                    
                </group>
            </search>
        </field>

    </record>


    <!-- l'action window pour le menu -->
    <record id="action_maintenance_menu" model="ir.actions.act_window">
        <field name="name">Maintenances</field>
        <field name="res_model">parc.maintenance</field>
        <field name="view_mode">list,form</field>

        <!-- Ajout du contexte pour forcer proprement le regroupement par défaut à l'initialisation -->
         <!-- 
            Le contexte permet de pré-cocher des filtres à l'ouverture de la page.
            'search_default_groupby_status': 1 active automatiquement le regroupement par statut 
            dès le chargement, ce qui force le Kanban à dessiner ses colonnes immédiatement.
        -->
        <field name="context">{'search_default_groupby_planifie': 1}</field>

        <!-- 
            Cette ligne associe explicitement cette action à votre vue de recherche personnalisée.
            Cela garantit qu'Odoo utilise les bons filtres (comme groupby_status) et évite les plantages RPC.
        -->
        <field name="search_view_id" ref="view_parc_automobile_maintenance"/>

    </record>
    

</odoo>
