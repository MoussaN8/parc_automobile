<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- listes des voitures -->
    <record id="view_parc_voiture" model="ir.ui.view">
        <field name="name">parc.voiture.tree</field>
        <field name="model">parc.voiture</field>
        <field name="arch" type="xml">

            <list string="Liste des voitures">
                <field name="name" />
                <field name="plaque" />
                <field name="marque" />
                <field name="modele" />
                <field name="chauffeur_id" />
                <field name="kilometrage" />
                <field name="statut" />
                <field name="cout_total" />

            </list>
        </field>

    </record>

    <!-- consulter une voiture spécifique -->
    <record id="view_parc_automobile_form" model="ir.ui.view">
        <field name="name">parc.automobile.form</field>
        <field name="model">parc.voiture</field>
        <field name="arch" type="xml">
            <form string="Voiture">
                <sheet>
                    <!-- bouton affichant le nombre de maintenances enregistrées.-->
                    <!-- 
                oe_button_box: Indique Odoo d'aligner automatiquement tous les boutons enfants horizontalement, de
                    leur donner une forme carrée grise et 
                de les placer tout en haut à droite de la feuille (<sheet>).
                Le nom (name="button_box"). Il permet à d'autres modules (via l'héritage XML) d'ajouter facilement
                    de nouveaux boutons à cet endroit 
                précis en ciblant cette boîte. 
                class="oe_stat_button" : Applique le style standard d'Odoo pour les boutons de statistiques (format
                    carré, positionné en haut à droite).
                icon="fa-wrench" : Affiche une icône de clé à molette (issue de FontAwesome) sur le bouton
                .widget="statinfo" : Formate le texte pour afficher le chiffre du champ maintenance_count juste
                    au-dessus du mot "Maintenances". -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_afficher_stats" type="object" class="oe_stat_button"
                            icon="fa-wrench">
                            <!-- Le champ qui affiche le nombre (ex: 5) -->
                            <field name="maintenance_count" widget="statinfo" string="Maintenances" />
                        </button>
                    </div>
                    <group>
                        <field name="name" />
                        <field name="plaque" />
                        <field name="marque" />
                        <field name="modele" />
                        <field name="chauffeur_id" />
                        <field name="kilometrage" />
                        <field name="statut" />
                        <field name="cout_total" />
                    </group>
                </sheet>

            </form>

        </field>

    </record>

     <!-- Vue kanban -->
      <record id="view_voitue_kanban" model="ir.ui.view">
        <field name="name">voiture_kanban_view</field>
        <field name="model">parc.voiture</field>

        <!--La structrure du kanban-->
        <field name="arch" type="xml">

            <!--Le conteneur principal-->
            <kanban default_group_by="statut" class="o_res_partner_kanban">
                <!--On déclare les champs qui seront chargés (affichés) par odoo-->
                <field name="name"/>
                <field name="plaque"/>
                <field name="marque"/>
                <field name="modele"/>
                <field name="chauffeur_id"/>
                <field name="statut"/>

                <!--contient le modéle d'affichage-->
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex flex-column justify-content-between p-2 ">
                            <div>
                                <div class="o_kanban_record_title fw-bold fs-5">
                                    <field name="name"/>
                                </div>

                                <div class="text-muted">
                                    <field name="marque"/> <field name="modele"/> • <field name="plaque"/>
                                </div>

                                <div class="mt-2" t-if="record.chauffeur_id.raw_value">
                                    <i class="fa fa-user me-1" title="Chauffeur"/>
                                    <field name="chauffeur_id"/>
                                </div>
                            </div>

                            <div class="mt-3 d-flex justify-content-between align-items-center">
                                <field name="statut" widget="badge" 
                                    decoration-success="statut == 'disponible'" 
                                    decoration-info="statut == 'en_service'" 
                                    decoration-danger="statut == 'maintenance'" 
                                    decoration-warning="statut == 'rebut'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>

        </field>

      </record>

    <!-- rechercher une voiture -->
    <record id="view_parc_automobile_search" model="ir.ui.view">
        <field name="name">parc.automobile.search</field>
        <field name="model">parc.voiture</field>
        <field name="arch" type="xml">
            <!-- champs sur lesquels le user pourrai faire des recherches  -->
            <search>
                <field name="name" />
                <field name="plaque" />
                <field name="marque" />
                <field name="chauffeur_id" />
            </search>
        </field>

    </record>

    <!-- l'action window pour le menu -->
    <record id="action_voiture_menu" model="ir.actions.act_window">
        <field name="name">Voitures</field>
        <field name="res_model">parc.voiture</field>
        <field name="view_mode">kanban,list,form</field>

    </record>


</odoo>