<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- On créé notre propre layout :  qui contient 3 parties-->
    <template id="parc_external_layout">
        <t t-call="web.html_container">

            <div class="header">
                <h4>
                    Gestion du Parc Automobile
                </h4>

            </div>

            <!-- on dit à Qweb Insère ici le contenu que le template appelant m’a transmis. »
            Donc notre fiche véhicule viendra à l’intérieur de :--> 
            <div class="article">
                <t t-out="0"/>
            </div>

            <div class="footer">
                <div style="text-align:center;">
                    <span>
                        Gestion du Parc Automobile
                    </span>

                    <span style="margin-left:30px;">

                        Page

                        <span class="page"/>
                        /
                        <span class="topage"/>

                    </span>

                    <span style="margin-left:30px;">

                        Imprimé le :

                        <span t-esc="time.strftime('%d/%m/%Y à %H:%M')"/>

                    </span>

                </div>
            </div>

        </t>
        
    </template>
</odoo>