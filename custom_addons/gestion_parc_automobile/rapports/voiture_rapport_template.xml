<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template principal du rapport -->
    <template id="rapport_voiture">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-call="gestion_parc_automobile.rapport_voiture_document" />

            </t>

        </t>

    </template>


    <!-- Document d'une voiture -->
    <template id="rapport_voiture_document">

        <t t-call="gestion_parc_automobile.parc_external_layout">

            <div class="page">

                <h2 style="text-align:center;">
                    Fiche du véhicule
                </h2>

                <br />

                <table class="table table-bordered">

                    <tr>
                        <th>Nom court</th>
                        <td>
                            <span t-field="o.name" />
                        </td>
                    </tr>

                    <tr>
                        <th>Plaque d'immatriculation</th>
                        <td>
                            <span t-field="o.plaque" />
                        </td>
                    </tr>

                    <tr>
                        <th>Marque</th>
                        <td>
                            <span t-field="o.marque" />
                        </td>
                    </tr>

                    <tr>
                        <th>Modèle</th>
                        <td>
                            <span t-field="o.modele" />
                        </td>
                    </tr>

                    <tr>
                        <th>Chauffeur</th>
                        <td>
                            <span t-field="o.chauffeur_id" />
                        </td>
                    </tr>

                    <tr>
                        <th>Kilométrage</th>
                        <td>
                            <span t-field="o.kilometrage" />
                        </td>
                    </tr>

                    <tr>
                        <th>Statut</th>

                        <td colspan="3">

                            <t t-if="o.statut == 'disponible'">

                                <span class="badge bg-success">

                                    Disponible

                                </span>

                            </t>

                            <t t-elif="o.statut == 'en_service'">

                                <span class="badge bg-primary">

                                    En service

                                </span>

                            </t>

                            <t t-elif="o.statut == 'maintenance'">

                                <span class="badge bg-warning text-dark">

                                    Maintenance

                                </span>

                            </t>

                            <t t-elif="o.statut == 'rebut'">

                                <span class="badge bg-danger">

                                    Rebut

                                </span>

                            </t>

                        </td>
                    </tr>

                    <tr>
                        <th>Nombre de maintenances</th>
                        <td>
                            <span t-field="o.maintenance_count" />
                        </td>
                    </tr>

                    <tr>
                        <th>Coût total des maintenances</th>
                        <td>
                            <span t-field="o.cout_total" /> FCFA </td>
                    </tr>

                </table>

                <h3 style="margin-top:30px;">
                    Statistiques
                </h3>

                <!--Statistiques
                maintenances-->
                <table class="table table-bordered">

                    <tr>

                        <th>
                            Nombre de maintenances
                        </th>

                        <td>
                            <span t-field="o.maintenance_count" />
                        </td>

                        <th>
                            Coût total des maintenances
                        </th>

                        <td>
                            <span t-field="o.cout_total" /> FCFA </td>

                    </tr>

                </table>

                <h3 style="margin-top:30px;">Historique des maintenances</h3>
                <t t-if="o.maintenance_ids">

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Titre du service</th>
                                <th>Voiture associée</th>
                                <th>Type de service</th>
                                <th>Date du service</th>
                                <th>Coût de la maintenance (FCFA)</th>
                                <th>Garage associé</th>
                                <th>Etat de la maintenance</th>
                                <th>Description</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="o.maintenance_ids" t-as="maintenance">
                                <tr>
                                    <td>
                                        <span t-field="maintenance.name"></span>
                                    </td>

                                    <td>
                                        <span t-field="maintenance.type_service"></span>
                                    </td>

                                    <td>
                                        <span t-field="maintenance.date_service" />
                                    </td>

                                    <td>
                                        <span t-field="maintenance.cout_maintenance"></span>
                                    </td>

                                    <td>
                                        <span t-field="maintenance.garage_id"></span>
                                    </td>

                                    <td>
                                        <span t-field="maintenance.etat"></span>
                                    </td>

                                    <td>
                                        <span t-field="maintenance.description"></span>
                                    </td>


                                </tr>
                            </t>
                        </tbody>

                        <tfoot>

                            <tr>

                                <th colspan="3" style="text-align:right;">
                                    Total des maintenances
                                </th>

                                <th>
                                    <span t-field="o.cout_total" /> FCFA </th>

                                <th colspan="3">
                                </th>

                            </tr>

                        </tfoot>
                    </table>
                </t>

                <t t-else="">
                    <p>Aucune maintenance enregistrée pour ce véhicule.</p>
                </t>

            </div>

        </t>


    </template>

</odoo>